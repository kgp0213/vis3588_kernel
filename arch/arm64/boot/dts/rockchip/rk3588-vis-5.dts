&hdmi0_in_vp0 {
	status = "disabled";
};
&pinctrl {//在驱动probe()阶段，由pinctrl子系统自动应用，配置GPIO的​​硬件电气特性​​
	//如果省略pinctrl配置，GPIO可能处于默认状态（如高阻态），导致信号不稳定。
	usb-typec {
		fusb302_int: fusb302-int {
			rockchip,pins = <1 RK_PA0 RK_FUNC_GPIO &pcfg_pull_up>;
		};

		typec_vbus_en: typec-vbus-en {
			rockchip,pins = <4 RK_PA7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	usb-host {
		usb_host_pwr_en: usb-host-pwr-en {
			rockchip,pins = <4 RK_PB0 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	leds {
		sys_led_pin: sys-led-pin {
			rockchip,pins = <3 RK_PB7 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	mipi_dsi0_power {
		mipi_dsi0_power_en:mipi-dsi0-powers{
			rockchip,pins = <3 RK_PA4 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};

	/*
	pmic {//rk860 电源控制管脚，已经被硬编码，但驱动框架会报：“vsel-gpios- not found!  en-gpios- not found!“无视即可
		vsel2_gpio: vsel2-gpio {//CPU BIG0
			//rockchip,pins =	<0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		vsel6_gpio: vsel6-gpio {//CPU BIG1
			//rockchip,pins =	<0 RK_PD6 RK_FUNC_GPIO &pcfg_pull_down>;
		};
		vsel3_gpio: vsel3-gpio {//NPU
			//rockchip,pins =	<0 RK_PC1 RK_FUNC_GPIO &pcfg_pull_down>;
		};
	};
	*/
};
